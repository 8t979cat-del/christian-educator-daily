# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real keys.

# Which environment this is: development | staging | production. See .env.staging.example and .env.production.example.
APP_ENV=development

# --- Public (safe for the browser) ---------------------------------
# Canonical site URL, used for absolute links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Time zone that defines "today" for devotionals and when scheduled ones go live (IANA name).
NEXT_PUBLIC_SITE_TIMEZONE=America/Los_Angeles

# Address that "Become a founding school" on the home page emails. Leave blank and the
# page says founding places are by invitation instead of showing a link.
FOUNDING_CONTACT_EMAIL=

# AI teaching tools (Educator Plus and school licences): re-leveling, and writing devotionals from topics.
# Server-only; never prefix with NEXT_PUBLIC_. Leave blank and the tools say they are not set up yet.
ANTHROPIC_API_KEY=

# Supabase project URL and anon (publishable) key.
# Find both in the Supabase dashboard under Project Settings > API.
# Leave blank to run the app without a database; pages still render and
# /api/health reports "not_configured".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only -----------------------------------------------------
# Used ONLY to delete a user's auth record on "Delete account" and to show
# staff emails on /admin. Never expose it to the browser. Without it, those
# two features report a clear error and everything else still works.
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (Stripe) -------------------------------------------------
# Both are required for checkout to be offered. Without them the pricing page
# still renders and checkout explains that billing is not set up yet.
# Secret API key (sk_test_... while testing). Server-only.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...), from Stripe > Developers > Webhooks,
# or printed by `stripe listen` when testing locally. Server-only.
STRIPE_WEBHOOK_SECRET=

# --- Scheduled jobs --------------------------------------------------
# Long random string. The retention job (/api/cron/retention) refuses every request
# that does not send `Authorization: Bearer <this value>`. Leave empty to disable the job.
CRON_SECRET=

# --- Error reporting -------------------------------------------------
# HTTPS endpoint that receives a sanitised JSON report of each unhandled server error (no bodies, headers or content).
ERROR_REPORT_URL=
ERROR_REPORT_TOKEN=
