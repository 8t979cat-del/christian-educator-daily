# PRODUCTION. Set these in the host's secret store. Never commit a filled-in copy; .env.production is git-ignored.
# Check before deploying:  node --env-file=.env.production scripts/check-env.mjs
APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.example.org
NEXT_PUBLIC_SITE_TIMEZONE=America/Los_Angeles
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PRODUCTION-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# LIVE Stripe credentials (sk_live_...) are added ONLY after explicit approval to charge real money.
# Leave both blank until then: checkout stays closed and the app says so. The check refuses a test key here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# openssl rand -hex 32  (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=
ERROR_REPORT_URL=
ERROR_REPORT_TOKEN=
