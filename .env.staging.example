# STAGING. A full copy of production's shape with TEST payment credentials and a SEPARATE Supabase project.
# Real people's data never goes here. Set these in the host's environment settings, not in a committed file.
# Check before deploying:  node --env-file=.env.staging scripts/check-env.mjs
APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.example.org
NEXT_PUBLIC_SITE_TIMEZONE=America/New_York
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stripe TEST mode only (sk_test_...). The check refuses a live key here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# openssl rand -hex 32
CRON_SECRET=
# Where unhandled server errors are reported (https). Optional token is sent as a Bearer header.
ERROR_REPORT_URL=
ERROR_REPORT_TOKEN=
